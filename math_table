from tkinter import *
from tkinter import messagebox

from tkinter.ttk import *

window = Tk()
window.title("Maths table")
window.configure(background="green")
window.geometry("450x500")

title = Label(window, text = "mathematical table", background="Blue",
              font=("Arial", 19, "bold"))

caption_label = Label(window,text="Number and range",background="white",
                      
                      font= ("Arial", 14, "normal"))

title.place( x= 100, y= 10)

caption_label.place(x= 20, y=100)

theNum = IntVar()
numbers = Combobox( window, textvariable= theNum, width= 10)

numbers.place(x= 200, y = 100)

numbers["value"] = tuple (range(101))

# radio buttons
endval = IntVar()
r10 = Radiobutton(window, text="10", variable = endval, value = 10)
r20 = Radiobutton(window, text="20",variable = endval, value = 20)
r30 = Radiobutton(window, text="30", variable = endval, value = 30)
endval.set(10)


r10.place(x= 300, y = 100)
r20.place(x= 300, y =120)
r30.place(x= 300, y = 140)

def generate_multiple_tables():
    tables = ""
    for i in range(1, endval.get()+1):
        tables += str(theNum.get() )+ " x " + str(i) + " = " + str(theNum.get()*(i))+ "\n" 








window.mainloop()

